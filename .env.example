# ==============================================================================
# ROADGUARD — ENVIRONMENT CONFIGURATION
# ==============================================================================

# System Mode
PORT=5000
NODE_ENV=development
DEMO_MODE=false
MOCK_AI_MODE=false

# ML / Python YOLO Service URL (if running ML inference server on port 5001)
YOLO_SERVICE_URL=http://localhost:5001

# Firebase Configuration (Optional in DEMO_MODE)
# To use real Firebase, provide your service account credentials or web config:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Or client-side web config for frontend:
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Maps API Key (Optional: Leaflet / OpenStreetMap fallback active when blank)
VITE_GOOGLE_MAPS_API_KEY=AIzaSyBLonZyB6W13PRVwgxJ_Iki6fYPNeJJrCw
VITE_API_URL=http://localhost:5000/api
